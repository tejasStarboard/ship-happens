{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build:sb-client-cli": "node ./scripts/vendor-sb-client-cli.mjs",
    "build": "pnpm run build:sb-client-cli && next build",
    "deploy": "eve deploy",
    "dev": "next dev --port 3000",
    "eval": "eve eval",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\" --ignore-path ../../.prettierignore",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "sb-client": "sb-client",
    "starboard:smoke-rates": "tsx --tsconfig ./tsconfig.json ./scripts/starboard-rate-search-smoke.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@react-email/components": "^1.0.12",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@starboard/sb-client": "workspace:*",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.47.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "2.2.0",
    "@workspace/ui": "workspace:*",
    "ai": "^7.0.128",
    "better-auth": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx-preview": "^0.4.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.72.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pptx-preview": "^1.0.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.30.0",
    "shiki": "3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@superradcompany/microsandbox-darwin-arm64": "0.5.5",
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "just-bash": "^3.6.0",
    "microsandbox": "0.5.5",
