{
  "name": "@ship-happens/sh-client",
  "version": "0.1.0",
  "private": true,
  "description": "Ship Happens fill CLI — status, progress, logs, reviews (Better Auth API key)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sh-client": "./bin/sh-client.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node ./bin/sh-client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,md}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,md}\" --ignore-path ../../.prettierignore",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
