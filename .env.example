# Database
POSTGRES_URL=postgresql://postgres:postgres@localhost:54325/ship_happens
POSTGRES_SSL=false

# Starboard (@ship-happens/sb-client) — required to call Starboard from server/CLI
# Keys: Starboard admin → company → Public API keys
STARBOARD_APP_DOMAIN=http://localhost:3001
STARBOARD_HANDSHAKE_KEY=
SB_CLIENT_CLIENT_ID=
SB_CLIENT_CLIENT_SECRET=
# Dev only — skips public_api_clients verify
# SB_CLIENT_COMPANY_ID=

# Redis
REDIS_URL=redis://localhost:63799

# Better Auth (min 32 chars)
BETTER_AUTH_SECRET=ship-happens-local-dev-secret-key-32c
BETTER_AUTH_DOMAIN=localhost

# Google OAuth (optional — leave empty to use email/password only)
# Also used for Gmail mailbox intake (gmail.readonly) when connecting Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook mailbox intake)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Shared clientState for Graph change notifications
OUTLOOK_WEBHOOK_CLIENT_STATE=ship-happens

# Gmail watch → Google Cloud Pub/Sub topic, e.g.
# projects/YOUR-PROJECT-ID/topics/ship-happens-gmail
# Create a push subscription targeting {APP_URL}/api/webhooks/gmail
# Grant gmail-api-push@system.gserviceaccount.com Pub/Sub Publisher on the topic.
GMAIL_PUBSUB_TOPIC=
# Optional ?token= on POST /api/webhooks/gmail
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# TypeSafe Jev (email relevant / not-relevant classification)
JEV_API_KEY=

# Client / app URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_local_dev_placeholder
EMAIL_SENDER_NAME=Ship Happens
EMAIL_SENDER_ADDRESS=noreply@localhost

# Blob
BLOB_STORE_ID=local
BLOB_READ_WRITE_TOKEN=vercel_blob_local_placeholder

# Vercel
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Vercel AI Gateway (optional locally if using OIDC on Vercel)
AI_GATEWAY_API_KEY=
